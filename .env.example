# Alibaba Cloud / Model Studio
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
DASHSCOPE_API_KEY=
ALIBABA_REGION=eu-central-1

# Planned model routing
MODEL_MANAGER=qwen3.8-max
MODEL_GENERAL_WORKER=qwen3.7-plus
MODEL_FAST_WORKER=qwen3.6-flash
MODEL_IMAGE=qwen-image-3.0-pro
MODEL_REALTIME_AUDIO=qwen-audio-3.0-realtime-plus

# Orchestrator
MAX_CONCURRENT_AGENTS=4
MAX_FLASH_AGENTS=3
MAX_GENERAL_AGENTS=2
AGENT_IDLE_TIMEOUT_SECONDS=300
TASK_HEARTBEAT_SECONDS=10

# Local services
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://jarvis:change-me@postgres:5432/jarvis
REDIS_URL=redis://redis:6379/0

# Artifact storage
OSS_ENDPOINT=
OSS_BUCKET=

# App
APP_ENV=development
LOG_LEVEL=INFO
